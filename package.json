{
  "name": "consensus-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Wavelength-style calibration game — own-device multiplayer rooms, Supabase backend, Vercel deployment",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "scales:sql": "tsx scripts/gen-scales-sql.ts",
    "hints:gen": "tsx scripts/gen-scale-hints.ts",
    "hints:sql": "tsx scripts/gen-hints-sql.ts",
    "mixpanel:test": "tsx scripts/mixpanel-test.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "22.x"
  }
}
