# ---- Supabase ----
# Project Settings -> API in the Supabase dashboard.

# Public: safe to expose to the browser. Used for the Realtime subscription
# and read-only queries guarded by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: NEVER prefix with NEXT_PUBLIC_. Every write goes through
# the API routes using this key, which bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
