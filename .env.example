# ---- Supabase ----
# Project Settings -> API in the Supabase dashboard.

# Public: safe to expose to the browser. Used for the Realtime subscription
# and read-only queries guarded by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: NEVER prefix with NEXT_PUBLIC_. Every write goes through
# the API routes using this key, which bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Analytics (both optional) ----

# Set this and /api/analytics requires it as an `x-analytics-key` header;
# the /analytics page forwards it from ?key=... in its own URL. Leave it
# unset and the numbers are readable by anyone who knows the URL.
# ANALYTICS_TOKEN=a-long-random-string

# Set to 1 to record a coarse 12x8 pointer heat grid, one event per page
# view. Off by default. Cursor trails are never recorded.
# NEXT_PUBLIC_TRACK_POINTER=1
