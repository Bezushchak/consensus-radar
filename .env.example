# ---- Supabase ----
# Project Settings -> API in the Supabase dashboard.

# Public: safe to expose to the browser. Used for the Realtime subscription
# and read-only queries guarded by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: NEVER prefix with NEXT_PUBLIC_. Every write goes through
# the API routes using this key, which bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Analytics (both optional) ----

# Set this and /api/analytics requires it as an `x-analytics-key` header;
# the /analytics page forwards it from ?key=... in its own URL. Leave it
# unset and the numbers are readable by anyone who knows the URL.
# ANALYTICS_TOKEN=a-long-random-string

# Set to 1 to record a coarse 12x8 pointer heat grid, one event per page
# view. Off by default. Cursor trails are never recorded.
# NEXT_PUBLIC_TRACK_POINTER=1

# ---- Housekeeping cron (optional, but recommended in production) ----
# Vercel sends this as `Authorization: Bearer <secret>` on every cron
# invocation of a project that has the variable set, which is the only thing
# that protects /api/cron/cleanup — the route holds the service-role key, so an
# open URL there would be an unauthenticated delete button. Leave it unset and
# the route refuses everything with a 503: a deploy that forgets the secret
# loses the cleanup rather than exposing it. Any long random string will do.
# CRON_SECRET=another-long-random-string

# ---- Mixpanel (optional) ----
# Mixpanel -> gear icon -> Project Settings -> Access Keys -> Project Token.
# This is a write-only, publicly-embeddable token: it cannot read your data.
# Set it and every event the app records is mirrored to Mixpanel as well as to
# your own analytics_events table. Unset, nothing is sent anywhere.
# MIXPANEL_TOKEN=your-project-token

# Data residency. Leave this alone if your project URL is eu.mixpanel.com.
# Set it to https://api.mixpanel.com only for a US-hosted project. Sending to
# the wrong region returns success and silently discards the data.
# MIXPANEL_HOST=https://api-eu.mixpanel.com
